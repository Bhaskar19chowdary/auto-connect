# =====================================================================
# Auto-Connect Environment Configuration  (copy to .env and fill in)
# =====================================================================

# Gemini API key (optional - without it the built-in banking rules engine is used)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8088
# Optional: protect the REST API. Clients must send header  X-API-Key: <value>
AUTO_CONNECT_API_KEY=

# Email (Gmail: use an App Password). Live sending is on when these are set,
# set SEND_LIVE_EMAIL=false to only write .eml files to the output folder.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SEND_LIVE_EMAIL=false
BANK_SENDER_EMAIL=you@yourbank.example
DEFAULT_CLIENT_EMAIL=

# Files
# Output folder for dossiers, SWIFT files and emails (empty = ./output)
AUTO_CONNECT_OUTPUT_DIR=
AUTO_CONNECT_COPY_TO_DESKTOP=false
# Where the bank's books are saved: a database URL (sqlite:///state/bank.db or postgresql://...)
AUTO_CONNECT_DATABASE_URL=sqlite:///state/bank.db
# Legacy JSON file (only used when no database URL is set)
AUTO_CONNECT_STATE_FILE=state/bank_state.json

# Trade finance operating parameters
BANK_BIC=DEMODEMMXXX
BANK_NAME=Demo Bank AG

# Per-client mailboxes (CLIENT_EMAIL_<customer id with _>)
CLIENT_EMAIL_DE_CORP_99214=client1@example.com

# ---------------------------------------------------------------------
# Production (bank) operation
# ---------------------------------------------------------------------
# production = named users required, reset/demo disabled, API docs hidden, CORS closed
AUTO_CONNECT_ENV=
AUTO_CONNECT_USERS_FILE=state/users.json
AUTO_CONNECT_AUDIT_FILE=state/audit/audit.jsonl
AUTO_CONNECT_ALLOWED_ORIGINS=
PUBLIC_BASE_URL=http://127.0.0.1:8088
# ISO20022 (pacs.008 / pacs.009, default) or MT (legacy MT103 / MT202)
PAYMENT_MESSAGE_FORMAT=ISO20022
# Live ECB rates + EU / OFAC sanctions lists (false = built-in samples)
TF_LIVE_REFERENCE_DATA=true
REFERENCE_DATA_DIR=
# End-of-day batch interval in minutes (0 = only when called)
TF_AUTO_BATCH_MINUTES=60
# Gemini on Vertex AI in the bank's Google Cloud project (instead of GEMINI_API_KEY)
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west3
# Connect each bank system to the real application (empty = built-in simulator):
#   TF_SYSTEM_URL_<AGENT_ID>=https://...   TF_SYSTEM_TOKEN_<AGENT_ID>=...
TF_SYSTEM_URL_TF_SWIFT_GATEWAY=

# ---------------------------------------------------------------------
# Connecting real bank systems (API gateway)
# ---------------------------------------------------------------------
# Only these hosts may be called (normally the API gateway + identity provider)
AUTO_CONNECT_ALLOWED_HOSTS=
AUTO_CONNECT_CA_BUNDLE=
AUTO_CONNECT_HTTPS_PROXY=
# Any credential field per bank system: TF_SYSTEM_<FIELD>_<AGENT_ID>. Secrets as references (env:NAME / file:/path)
# Example: core ledger via the gateway with OAuth 2.0 + mTLS
TF_SYSTEM_URL_TF_CORE_LEDGER=
TF_SYSTEM_AUTH_TYPE_TF_CORE_LEDGER=
TF_SYSTEM_OAUTH_TOKEN_URL_TF_CORE_LEDGER=
TF_SYSTEM_OAUTH_CLIENT_ID_TF_CORE_LEDGER=
TF_SYSTEM_OAUTH_CLIENT_SECRET_TF_CORE_LEDGER=env:LEDGER_CLIENT_SECRET
TF_SYSTEM_CLIENT_CERT_FILE_TF_CORE_LEDGER=
TF_SYSTEM_CLIENT_KEY_FILE_TF_CORE_LEDGER=
# Example: SWIFT via a hot folder (raw FIN / ISO 20022 files)
TF_SYSTEM_TRANSPORT_TF_SWIFT_GATEWAY=
TF_SYSTEM_TRANSPORT_TARGET_TF_SWIFT_GATEWAY=
TF_SYSTEM_TRANSPORT_FORMAT_TF_SWIFT_GATEWAY=RAW:fin_text
# OCR languages for scanned documents (installed packs only)
OCR_LANGUAGES=deu+eng
